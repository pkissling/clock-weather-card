{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor-dependencies",
      "matchPackageNames": ["*"],
      "automerge": true
    },
    {
      "matchPackageNames": ["lit"],
      "matchUpdateTypes": ["minor", "patch"],
      "enabled": true
    },
    {
      "description": "3.32 is a mistagged 3.3.2",
      "matchPackageNames": ["aFFekopp/noctis"],
      "allowedVersions": "!/^3\\.32$/"
    }
  ],
  "schedule": ["before 9am on tuesday"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Docs preview themes in the README, both the preview comment and the theme link",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "theme: \\{ repo: (?<depName>[\\w.-]+/[\\w.-]+), version: (?<currentValue>[^,\\s]+),",
        "\\]\\(https://github\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/tree/(?<currentValue>[^)\\s]+)\\)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
